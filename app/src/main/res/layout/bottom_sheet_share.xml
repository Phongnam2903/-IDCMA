<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chia sẻ chứng chỉ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateLink"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔗 Tạo Link Bảo mật"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareEmail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📧 Gửi qua Email"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareOther"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📤 Chia sẻ khác"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="12dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <TextView
        android:id="@+id/tvShareLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#666666"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:fontFamily="monospace" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyLink"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📋 Sao chép Link"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:cornerRadius="8dp"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>

