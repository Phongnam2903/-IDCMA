<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:text="Thêm Chứng Chỉ Mới"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/black"/>

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên chứng chỉ"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"/>

        <EditText
            android:id="@+id/edtIssuer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tổ chức cấp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"/>

        <EditText
            android:id="@+id/edtIssueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày cấp (dd/MM/yyyy)"
            android:inputType="date"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"/>

        <EditText
            android:id="@+id/edtExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày hết hạn (dd/MM/yyyy)"
            android:inputType="none"
            android:focusable="false"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"/>

        <EditText
            android:id="@+id/edtCredentialId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã định danh (nếu có)"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"/>


        <!-- Upload file -->
        <Button
            android:id="@+id/btnUploadFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn file chứng chỉ (PDF hoặc ảnh)"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/teal_700"/>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa chọn file"
            android:textColor="#666666"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu chứng chỉ"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
