<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical">



        <TextView
            android:id="@+id/tvCertificateName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên Chứng chỉ: abc"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvRecipientEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chia sẻ với: abc@example.com"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvIssuer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổ chức cấp: abc"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvShareDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày chia sẻ: 30/10/2010 10:20"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái: Active"
            android:textSize="14sp"
            android:textColor="#007700"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liên kết: Xem"
            android:textSize="14sp"
            android:textColor="@color/design_default_color_primary"
            android:layout_marginTop="4dp"
            android:textStyle="italic"
            android:maxLines="1"
            android:ellipsize="middle" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>