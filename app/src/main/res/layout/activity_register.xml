<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient"
    tools:context=".view.auth.RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:layout_gravity="center_vertical">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/rounded_icon_bg"
                android:layout_marginBottom="16dp"
                android:elevation="8dp" />

            <TextView
                android:text="Đăng ký tài khoản"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Tạo tài khoản mới để bắt đầu"
                android:textSize="16sp"
                android:textColor="@color/teal_200"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Register Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Họ và tên -->
                <TextView
                    android:text="Họ và tên"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:hint="Nhập họ và tên của bạn"
                    android:inputType="textPersonName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_selector"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:textColorHint="@color/gray_dark"
                    android:layout_marginBottom="20dp"
                    android:drawableStart="@android:drawable/ic_menu_myplaces"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/teal_700" />

                <!-- Email -->
                <TextView
                    android:text="Email"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:hint="Nhập email của bạn"
                    android:inputType="textEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_selector"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:textColorHint="@color/gray_dark"
                    android:layout_marginBottom="20dp"
                    android:drawableStart="@android:drawable/ic_dialog_email"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/teal_700" />

                <!-- Số điện thoại -->
                <TextView
                    android:text="Số điện thoại"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:hint="Nhập số điện thoại của bạn"
                    android:inputType="phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_selector"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:textColorHint="@color/gray_dark"
                    android:layout_marginBottom="20dp"
                    android:drawableStart="@android:drawable/ic_menu_call"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/teal_700" />

                <!-- Mật khẩu -->
                <TextView
                    android:text="Mật khẩu"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:hint="Nhập mật khẩu của bạn"
                    android:inputType="textPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_selector"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:textColorHint="@color/gray_dark"
                    android:layout_marginBottom="20dp"
                    android:drawableStart="@android:drawable/ic_lock_lock"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/teal_700" />

                <!-- Xác nhận mật khẩu -->
                <TextView
                    android:text="Xác nhận mật khẩu"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:hint="Nhập lại mật khẩu của bạn"
                    android:inputType="textPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_selector"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:textColorHint="@color/gray_dark"
                    android:layout_marginBottom="24dp"
                    android:drawableStart="@android:drawable/ic_lock_lock"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/teal_700" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:text="Đăng ký"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp" />

        <!-- Login Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:text="Đã có tài khoản? "
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLogin"
                android:text="Đăng nhập ngay"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
