<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style for PopupMenu to make text more visible -->
    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:textColor">@color/menu_text_dark</item>
        <item name="android:background">@android:color/white</item>
    </style>
    
    <!-- Theme overlay for ActionBar to make menu text dark -->
    <style name="ThemeOverlay.MenuStyle" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <!-- Use light theme overlay but with dark text -->
        <item name="android:textColorPrimary">@color/menu_text_dark</item>
        <item name="android:textColorSecondary">@color/menu_text_dark</item>
        <item name="android:textColor">@color/menu_text_dark</item>
        <item name="android:textColorHint">@color/menu_text_dark</item>
        <item name="colorControlNormal">@color/menu_text_dark</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:itemTextAppearance">?android:attr/textAppearanceLargePopupMenu</item>
    </style>
    
    <!-- Alternative: Light theme overlay for popup menu -->
    <style name="ThemeOverlay.MenuStyleLight" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">@color/menu_text_dark</item>
        <item name="android:textColorSecondary">@color/menu_text_dark</item>
        <item name="android:textColor">@color/menu_text_dark</item>
        <item name="android:colorBackground">@android:color/white</item>
    </style>
    
    <!-- Custom Toolbar style with dark menu text -->
    <style name="ToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="popupTheme">@style/ThemeOverlay.MenuStyleLight</item>
        <item name="theme">@style/ThemeOverlay.MenuStyleLight</item>
    </style>
</resources>