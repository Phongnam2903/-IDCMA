<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.idcma_project_prm392">

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IDCMA_Project_PRM392"
        tools:targetApi="31">

        <!-- Màn hình đăng nhập (được chạy đầu tiên khi mở app) -->
        <activity
            android:name=".view.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính (Dashboard sau khi đăng nhập thành công) -->
        <activity android:name=".MainActivity" />

        <!-- Các màn hình khác -->
        <!-- <activity android:name=".ui.dashboard.DashboardActivity" /> -->
        <!-- <activity android:name=".ui.search.SearchFilterActivity" /> -->
        <!-- <activity android:name=".ui.detail.CertificateDetailActivity" /> -->

    </application>

</manifest>
